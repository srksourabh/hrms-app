{
  "name": "hrms-app",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest",
    "arch:review": "node scripts/architecture-review-agent.mjs",
    "db:push": "pnpm -F @hrms-app/db db:push",
    "db:generate": "pnpm -F @hrms-app/db db:generate",
    "db:migrate": "pnpm -F @hrms-app/db db:migrate",
    "db:studio": "pnpm -F @hrms-app/db db:studio",
    "clean": "turbo clean && rimraf node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "turbo": "^2.10.4",
    "vitest": "^3.0.0"
  }
}
